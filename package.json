{
  "name": "@dsh-external/local-git-4-llm",
  "version": "0.6.1",
  "description": "A workspace-scoped DSH knowledge repository with explicit immutable local file backup.",
  "private": true,
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "files": [
    "lib"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kelai141/local-git-4-llm.git"
  },
  "bugs": {
    "url": "https://github.com/kelai141/local-git-4-llm/issues"
  },
  "homepage": "https://github.com/kelai141/local-git-4-llm#readme",
  "peerDependencies": {
    "@deepseek-ai/cordis-plugin-timer": ">=0.0.1-rc <2",
    "@deepseek-ai/dsh-commands": ">=0.0.1-rc <2",
    "@deepseek-ai/dsh-client-runtime": ">=0.0.1-rc <2",
    "@deepseek-ai/dsh-client-ui-layout": ">=0.0.1-rc <2",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.0.1-rc <2",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.0.1-rc <2",
    "@deepseek-ai/dsh-agent": ">=0.0.1-rc <2",
    "@deepseek-ai/dsh-host-webserver": ">=0.0.1-rc <2",
    "@deepseek-ai/dsh-llm": ">=0.0.1-rc <2",
    "@deepseek-ai/dsh-session": ">=0.0.1-rc <2",
    "@deepseek-ai/dsh-tools": ">=0.0.1-rc <2",
    "@deepseek-ai/dsh-workspace": ">=0.0.1-rc <2",
    "cordis": ">=4.0.0-rc <5",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.0"
  },
  "scripts": {
    "build": "bash scripts/build.sh",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:client": "tsdown",
    "test:m1a": "npm run build && node --test tests/m1a-reader.test.mjs",
    "test:m1b-init": "npm run build && node --test tests/m1b-init.test.mjs",
    "test:m1b-commit": "npm run build && node --test tests/m1b-commit.test.mjs",
    "test:m3-admin-api": "npm run build && node --test tests/m3-admin-api.test.mjs",
    "test:m3-discussion": "npm run build && node --test tests/m3-discussion-tools.test.mjs",
    "test:m4-backup": "npm run build && node --test tests/m4-file-backup.test.mjs",
    "test:m4-setrepo": "npm run build && node --test tests/m4-setrepo.test.mjs",
    "test:repository": "npm run build && node --test tests/m1a-reader.test.mjs tests/m1b-init.test.mjs tests/m1b-commit.test.mjs tests/m3-admin-api.test.mjs tests/m3-discussion-tools.test.mjs tests/m4-file-backup.test.mjs tests/m4-setrepo.test.mjs"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-primitives"
      ],
      "platform": "web"
    }
  }
}
